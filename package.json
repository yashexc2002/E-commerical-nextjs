{
  "name": "shopvilla",
  "version": "1.0.0",
  "author": "Yash Oberoi",
  "description": "Shopvilla full-stack MERN e-commerce platform",
  "scripts": {
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "next build",
    "render-build": "npm install && npm run build",
    "start": "cd backend && npm start",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm --prefix backend run dev",
    "start:frontend": "next dev",
    "seed": "npm --prefix backend run seed"
  },
  "dependencies": {
    "concurrently": "^8.2.1",
    "next": "^14.2.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}